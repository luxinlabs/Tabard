# Copy to server/.env (ignored by git) and fill in.
ZOOWORK_API_KEY=            # zwp_live_... Project key from the ZooWork app → Settings → API Keys
# ZOOWORK_MODEL=litellm/claude-opus-5-5
# ZOOWORK_AGENTS=promo,concierge   # or "all"
# TAVILY_API_KEY=            # needed to import a shop from a store link
# ANTHROPIC_API_KEY=         # optional: better catalog extraction when importing

# Band (band.ai): register each agent at app.band.ai/agents → "Remote Agent", copy its API key.
# Band turns on when CONCIERGE and SHOPPER are set; roles without a key are relayed by the concierge.
# BAND_KEY_CONCIERGE=
# BAND_KEY_SHOPPER=          # speaks for the simulated Muse/Dots buyer agents
# BAND_KEY_STYLIST=
# BAND_KEY_PROMO=
# BAND_KEY_SERVICE=
# BAND_KEY_RETURNS=
# BAND_KEY_GATEKEEPER=
